# ============================================================
# DeepResearch Agent - environment variables
#
# Copy this file to .env and fill in your keys:
#     cp .env.example .env
#
# .env is listed in .gitignore and will never be committed.
#
# NOTE: keep this file PURE ASCII.
#   .env files are read by many tools (langgraph-cli, docker,
#   IDE plugins, various dotenv loaders). Not all of them decode
#   UTF-8, and on Windows the default is GBK -- a Chinese
#   comment here can break `langgraph dev` with a
#   UnicodeDecodeError that points at the .env file.
# ============================================================

# ---------- LLM (at least one required) ----------
# DeepSeek - the default provider. Sign up: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Qwen - only needed when LLM_PROVIDER=qwen
# Sign up: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# ---------- Search (required) ----------
# Tavily free tier: 1000 credits/month. Sign up: https://app.tavily.com/
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Observability (recommended) ----------
# LangSmith free tier is enough. Sign up: https://smith.langchain.com/
# If api.smith.langchain.com is unreachable, set LANGSMITH_TRACING=false
# and everything still works -- you just lose the traces.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=deepresearch-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Model selection ----------
# deepseek | qwen | openai
LLM_PROVIDER=deepseek

# ---------- Proxy (optional) ----------
# May be needed to reach Tavily / LangSmith from mainland China.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
